{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "integer"
    },
    "deleteDatasources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "orgId": {
            "type": "integer"
          }
        },
        "required": ["name"],
        "type": "object"
      },
      "type": "array"
    },
    "datasources": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "access": {
            "type": "string"
          },
          "editable": {
            "type": "boolean"
          },
          "isDefault": {
            "type": "boolean"
          },
          "jsonData": {
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "uid": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": ["name", "type", "url"],
        "type": "object"
      },
      "type": "array"
    },
    "prune": {
      "type": "boolean"
    }
  },
  "required": ["apiVersion", "datasources"],
  "type": "object"
}
